{
  "info": {
    "name": "Doc-Intel-Extract API Collection",
    "description": "Postman collection demonstrating the full API surface of the Document Processing & Question Extraction Service.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000",
      "type": "string"
    },
    {
      "key": "access_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "document_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "question_id",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Authentication & Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/health",
              "host": ["{{base_url}}"],
              "path": ["health"]
            }
          }
        },
        {
          "name": "Login (Get JWT Access Token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.access_token) {",
                  "    pm.collectionVariables.set('access_token', jsonData.access_token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "username",
                  "value": "admin@pbnc.internal",
                  "type": "text"
                },
                {
                  "key": "password",
                  "value": "admin12345",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/token",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "token"]
            }
          }
        },
        {
          "name": "Get Current User Profile",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/auth/me",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "me"]
            }
          }
        }
      ]
    },
    {
      "name": "Document Ingestion & Processing",
      "item": [
        {
          "name": "Upload Document (PDF / Image)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.id) {",
                  "    pm.collectionVariables.set('document_id', jsonData.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": []
                },
                {
                  "key": "doc_type",
                  "value": "question_paper",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/api/v1/documents/upload",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "documents", "upload"]
            }
          }
        },
        {
          "name": "Check Processing Status",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/documents/{{document_id}}/status",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "documents", "{{document_id}}", "status"]
            }
          }
        },
        {
          "name": "Retrieve Extracted Questions",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/documents/{{document_id}}/questions",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "documents", "{{document_id}}", "questions"]
            }
          }
        },
        {
          "name": "Retrieve Document Answers",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/documents/{{document_id}}/answers",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "documents", "{{document_id}}", "answers"]
            }
          }
        },
        {
          "name": "Retrieve Document Warnings",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/documents/{{document_id}}/warnings",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "documents", "{{document_id}}", "warnings"]
            }
          }
        },
        {
          "name": "Link Related Documents (Paper <-> Answer Key)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"source_document_id\": \"{{document_id}}\",\n  \"target_document_id\": \"{{document_id}}\",\n  \"relationship_type\": \"answer_key_for\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/documents/link",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "documents", "link"]
            }
          }
        }
      ]
    },
    {
      "name": "Questions & Review Queue",
      "item": [
        {
          "name": "Get Single Question Detail",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/questions/{{question_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "questions", "{{question_id}}"]
            }
          }
        },
        {
          "name": "Resolve Question Review",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/questions/{{question_id}}/resolve",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "questions", "{{question_id}}", "resolve"]
            }
          }
        },
        {
          "name": "Get Review Queue",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/review-queue",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "review-queue"]
            }
          }
        }
      ]
    }
  ]
}
