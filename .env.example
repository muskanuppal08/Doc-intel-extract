# Environment Configuration
PROJECT_NAME="Document Processing & Question Extraction Service"
VERSION="1.0.0"
API_V1_STR="/api/v1"
DEBUG=True
ENVIRONMENT="development"

# Security
SECRET_KEY="dev-insecure-secret-key-change-in-production-1234567890abcdef"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database (Set USE_SQLITE=True for lightweight local development/tests)
USE_SQLITE=True
DATABASE_URL="sqlite:///./app.db"
# For PostgreSQL:
# DATABASE_URL="postgresql+psycopg://postgres:postgres@localhost:5432/pbnc_questions"
POSTGRES_SERVER="localhost"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_DB="pbnc_questions"
POSTGRES_PORT=5432

# Redis
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL="redis://localhost:6379/0"

# Storage
STORAGE_BACKEND="local"
UPLOAD_DIR_NAME="storage/uploads"
CROPS_DIR_NAME="storage/crops"
MAX_FILE_SIZE_BYTES=52428800

# Extraction & AI Vision Provider
OCR_ENGINE="hybrid"
AI_PROVIDER="mock"
GEMINI_API_KEY=""
OPENAI_API_KEY=""
TESSERACT_CMD=""

# Quality & Review Thresholds
CONFIDENCE_THRESHOLD_REVIEW=0.80
CONFIDENCE_THRESHOLD_HIGH=0.90
